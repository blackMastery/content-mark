# Use the final HTTPS production domain, with no trailing path.
NEXT_PUBLIC_SITE_URL=

# Generated for local development by `npm run db:env`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key: NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend: verify your sending domain before using its address here.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# At least 32 random bytes, stable across every deployment instance.
CONTACT_FORM_SECRET=

# Optional: international country code and number, digits only. Hidden until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: hidden until set to a valid Instagram profile URL.
NEXT_PUBLIC_INSTAGRAM_URL=

# Recommended on Vercel: shared rate limits across serverless instances.
# Without these, a bounded in-memory limiter protects each individual instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
